{
  "name": "branchly",
  "productName": "Branchly",
  "version": "0.4.2",
  "description": "Git GUI 클라이언트",
  "private": true,
  "main": "dist/main/main.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:main": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outdir=dist/main --out-extension:.js=.cjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && npm run notices && electron-builder --win",
    "serve-updates": "node scripts/serve-updates.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.108.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.75.0",
    "playwright-core": "^1.65.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "esbuild@0.28.2": true
  },
  "type": "module",
  "author": "Branchly",
  "build": {
    "appId": "app.branchly.desktop",
    "productName": "Branchly",
    "copyright": "Copyright © 2026 Branchly",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Branchly",
      "artifactName": "Branchly-Setup-${version}.${ext}",
      "uninstallDisplayName": "Branchly",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ]
    },
    "portable": {
      "artifactName": "Branchly-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/winjun0221/branchly/releases/latest/download/"
      }
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "homepage": "https://github.com/winjun0221/branchly",
  "license": "MIT"
}
